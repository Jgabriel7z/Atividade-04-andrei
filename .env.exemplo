# Copie para .env (o iniciar.cmd faz isso na primeira vez) e preencha.
# O .env não vai para o git.

# Chave do Groq, gratuita em https://console.groq.com/keys
GROQ_API_KEY=

# Modelo padrão. Cada pessoa pode trocar no topo da tela.
GROQ_MODEL=openai/gpt-oss-120b

# Quem pode entrar: login:senha:Nome que aparece, separados por vírgula.
# Sem esta linha, o app abre sem login e todo mundo aparece como "Visitante".
EIXOAI_USUARIOS=joao:troque-esta-senha:João Gabriel,luiz:troque-esta-senha:Luiz Alberto

# 1 tenta criar o link público *.gradio.live (dura 72 h); 0 desliga.
EIXOAI_LINK_PUBLICO=1

# 1 abre o navegador sozinho quando o app sobe; 0 não abre.
EIXOAI_ABRIR_NAVEGADOR=1

# Porta do app. Na mesma rede ou VPN, a equipe entra por http://<ip-desta-maquina>:7860
EIXOAI_PORTA=7860
